# Neon Postgres — copie para .env e preencha (neon link puxa automatico)
# Neon > Dashboard > Connect > Pooled (DATABASE_URL) e Unpooled (DIRECT_URL)

DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.neon.tech/db?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://user:pass@ep-xxx.neon.tech/db?sslmode=require&channel_binding=require"

# App
PORT=3000
FRONTEND_URL="http://localhost:3001"
JWT_SECRET="troque-por-um-segredo-forte-32chars+"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="outro-segredo-forte-32chars+"
JWT_REFRESH_EXPIRES_IN="7d"

# Local Prisma Postgres (npx prisma dev) — descomente se não usar Supabase
# DATABASE_URL="prisma+postgres://localhost:51213/?api_key=..."
